# API
API_KEY=your-secret-api-key

# Core app
DATABASE_URL=postgresql+asyncpg://user:pass@host:5432/postgres
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# Kroki and Mermaid fallback
KROKI_BASE_URL=https://kroki.io
MERMAID_INK_BASE_URL=https://mermaid.ink

# Base app verification meta tag
BASE_APP_ID=6a610cc0078f6baf9ef30219

# x402 payment gating
X402_ENABLED=true
X402_FACILITATOR_URL=https://dexter.cash/facilitator/base
X402_NETWORK=eip155:84532
X402_PAY_TO=0xC4b867EAeeDcFCe9B794a3f791F48f82ecc1350C
X402_PRICE_SVG=$0.05
X402_PRICE_PNG=$0.07

# Builder code is intentionally left blank for the exact EVM flow.
# Including it causes the signed payload to become invalid.
X402_BUILDER_CODE=

# Optional CDP config if you later switch facilitators
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# CDP_API_KEY_ID=organizations/your-org-id/apiKeys/your-key-id
# CDP_API_KEY_SECRET=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# Local buyer test client
X402_PAID_ENDPOINT_URL=http://127.0.0.1:8000/paid/diagrams/generate/svg
EVM_PRIVATE_KEY=0xyourbuyerprivatekey
