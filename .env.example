# API
API_KEY=your-secret-api-key

# PostgreSQL (Supabase connection string)
DATABASE_URL=******host:5432/postgres
# For Vercel quickstart with sqlite fallback, use:
# DATABASE_URL=sqlite+aiosqlite:////tmp/test.db

# Redis
REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4

# Kroki
KROKI_BASE_URL=https://kroki.io

# Mermaid fallback
MERMAID_INK_BASE_URL=https://mermaid.ink

# Base app verification meta tag (for dashboard.base.org domain verification)
BASE_APP_ID=6a610cc0078f6baf9ef30219

# Stripe MPP (Machine Payments Protocol)
# Required for the machine payment gateway that exposes /paid for Stripe SPTs + Tempo crypto.
PORT=4242
MPP_PORT=4242
STRIPE_SECRET_KEY=
STRIPE_PROFILE_ID=
TEMPO_CURRENCY=
TEMPO_RECIPIENT=
TEMPO_DEPOSIT_ADDRESS=
MPP_TEMPO_AMOUNT=0.50
MPP_STRIPE_AMOUNT=0.50

# x402 (seller/resource server)
X402_ENABLED=false
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_NETWORK=eip155:84532
X402_PAY_TO=0xYourBaseWalletAddress
X402_PRICE_SVG=$0.03
X402_PRICE_PNG=$0.05
X402_PRICE_PDF=$0.07
X402_BUILDER_CODE=bc_yourbuildercode
# Required only when using CDP facilitator URL:
# X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
CDP_API_KEY_ID=organizations/your-org-id/apiKeys/your-key-id
CDP_API_KEY_SECRET=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# x402 buyer test client (for end-to-end payment verification)
X402_PAID_ENDPOINT_URL=http://127.0.0.1:8000/paid/diagrams/generate/svg
EVM_PRIVATE_KEY=0xyourbuyerprivatekey
